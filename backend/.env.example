PORT=5000

# MongoDB Configuration:
# Local MongoDB:
# MONGO_URI=mongodb://localhost:27017/agrii_ai

# MongoDB Atlas:
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/agrii_ai?retryWrites=true&w=majority

# Gemini AI API Key
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# JWT Secret Key
JWT_SECRET=YOUR_NEW_LONG_RANDOM_JWT_SECRET_HERE

# News API Key (from https://newsapi.org/)
NEWS_API_KEY=YOUR_NEWS_API_KEY
